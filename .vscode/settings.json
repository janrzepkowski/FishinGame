{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true
  },

  "stylua.searchParentDirectories": true,

  // luau-lsp czyta sourcemap.json, żeby wiedzieć, że `script.Parent.Services`
  // to naprawdę istniejący folder. Generuje go `rojo sourcemap --watch`
  // (patrz zadanie "Rojo: sourcemap (watch)" w .vscode/tasks.json).
  "luau-lsp.sourcemap.enabled": true,
  "luau-lsp.sourcemap.autogenerate": true,
  "luau-lsp.sourcemap.rojoProjectFile": "default.project.json",
  "luau-lsp.sourcemap.includeNonScripts": true,
  "luau-lsp.types.roblox": true,
  "luau-lsp.completion.imports.enabled": true,
  "luau-lsp.inlayHints.parameterNames": "literals",

  "search.exclude": {
    "**/Packages": true,
    "**/build": true,
    "sourcemap.json": true,
    "globalTypes.d.luau": true,
    "roblox.toml": true
  },

  "editor.rulers": [100]
}
