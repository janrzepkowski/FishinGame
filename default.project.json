{
  "name": "FishinGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,

        "StreamingEnabled": true,
        "StreamingMinRadius": 160,
        "StreamingTargetRadius": 512,
        "StreamingIntegrityMode": "MinimumRadiusPause"
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.42, 0.42, 0.5],
        "Brightness": 3.2,
        "ClockTime": 14,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.2,
        "ExposureCompensation": 0.2,
        "GeographicLatitude": 52,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.62, 0.62, 0.72],
        "Outlines": false,
        "ShadowSoftness": 0.6,
        "Technology": "ShadowMap"
      },

      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [0.78, 0.9, 1],
          "Decay": [0.6, 0.78, 1],
          "Density": 0.22,
          "Glare": 0.1,
          "Haze": 0.35,
          "Offset": 0.1
        }
      },

      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.3
        }
      },

      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.03,
          "Contrast": 0.12,
          "Saturation": 0.32,
          "TintColor": [1, 0.988235, 0.964705]
        }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
