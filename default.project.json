{
  "name": "FishinGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "BottomSurface": "Smooth",
          "Color": [0.321568, 0.439215, 0.243137],
          "Locked": true,
          "Material": "Grass",
          "Position": [0, -10, 0],
          "Size": [512, 20, 512],
          "TopSurface": "Smooth"
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.101960, 0.117647, 0.156862],
        "Brightness": 2.5,
        "ClockTime": 15,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.419607, 0.470588, 0.541176],
        "Outlines": false,
        "Technology": "ShadowMap"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
