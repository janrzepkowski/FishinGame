{
  "name": "FishinGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,

        "StreamingEnabled": true,
        "StreamingMinRadius": 160,
        "StreamingTargetRadius": 512,
        "StreamingIntegrityMode": "MinimumRadiusPause"
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.117647, 0.133333, 0.168627],
        "Brightness": 2.4,
        "ClockTime": 17.5,
        "EnvironmentDiffuseScale": 0.45,
        "EnvironmentSpecularScale": 0.35,
        "ExposureCompensation": 0.15,
        "GeographicLatitude": 52,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.447058, 0.498039, 0.564705],
        "Outlines": false,
        "ShadowSoftness": 0.2,
        "Technology": "ShadowMap"
      },

      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [0.788235, 0.819607, 0.862745],
          "Decay": [0.419607, 0.470588, 0.556862],
          "Density": 0.25,
          "Glare": 0.25,
          "Haze": 0.6,
          "Offset": 0.2
        }
      },

      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.55,
          "Size": 22,
          "Threshold": 1.65
        }
      },

      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.08,
          "Spread": 0.6
        }
      },

      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.015,
          "Contrast": 0.09,
          "Saturation": 0.12,
          "TintColor": [1, 0.92549, 0.823529]
        }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
