root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Taby w Luau — tak robi StyLua i tak wygląda kod w Roblox Studio.
[*.{luau,lua}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,toml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
